{
  "name": "codex-provider",
  "version": "0.1.0-alpha.0",
  "private": false,
  "type": "module",
  "description": "Provider compatibility SDK that lets non-OpenAI models participate in the Codex native tool-call loop.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codex-provider-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "examples",
    "install.sh",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm test && pnpm typecheck && pnpm build && pnpm consumer:harness && pnpm check-boundary && pnpm check-package-surface",
    "check-boundary": "node scripts/check-boundary.mjs",
    "check-package-surface": "node scripts/check-package-surface.mjs",
    "consumer:harness": "pnpm build && tsx examples/standalone-consumer-harness.ts",
    "pack:dry-run": "npm pack --dry-run",
    "public-alpha:audit": "node scripts/check-public-alpha-readiness.mjs",
    "serve": "node ./dist/cli.js",
    "smoke:host": "pnpm build && npm pack --dry-run && tsx examples/live-host-integration-smoke.ts",
    "smoke:web-search": "pnpm build && tsx examples/live-web-search-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
